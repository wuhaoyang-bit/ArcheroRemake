{
  "name": "archero-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --host 0.0.0.0 --mode mobile",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tools/browser-check.mjs",
    "test:character": "node tools/character-browser-check.mjs",
    "test:lock-rings": "node tools/lock-rings-browser-check.mjs",
    "test:attack": "node tools/attack-browser-check.mjs",
    "test:turn-curve": "node tools/turn-curve-browser-check.mjs",
    "test:turn-model": "node tools/turn-model-browser-check.mjs",
    "test:release": "node tools/release-browser-check.mjs",
    "test:settings": "node tools/settings-browser-check.mjs",
    "android:sync": "npm run build && tsx tools/sync-android.ts",
    "android:build": "npm run android:sync && bash tools/build-android.sh && tsx tools/verify-apk.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
